{
  "manifest_version": 3,
  "name": "Wiki Clipper",
  "version": "0.1.0",
  "description": "Clip a page straight into the right folder of your Obsidian wiki, and queue it for ingest.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to wiki",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": ["activeTab", "scripting"],

  "host_permissions": ["http://127.0.0.1:4141/*"],

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Clip the current page"
    }
  }
}
